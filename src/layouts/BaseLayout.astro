---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { href } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  variant?: 'home' | 'default';
}

const { title, description = 'Learning deep-dives and sports adventures.', variant = 'default' } = Astro.props;

const SITE_TITLE = 'Fábio Carneiro';
// The site root passes title === SITE_TITLE (tab reads as just the name);
// every other page gets "<page> · <name>".
const docTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const year = new Date().getFullYear();

// Footer socials — extensible: add a line here to grow the list.
const SOCIALS = [
  { label: 'GitHub', url: 'https://github.com/fabiocfabini' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- JS-driven <html> state (theme, opt-in sound, motion-gated reveal flag). Applied
         pre-paint AND re-applied on every view-transition swap — Astro replaces <html>
         attributes during a swap, which would otherwise flash the wrong theme / reset state. -->
    <script is:inline>
      (function () {
        function applyHtmlState() {
          var el = document.documentElement;
          try {
            var theme = localStorage.getItem('theme') ||
              (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            el.setAttribute('data-theme', theme);
            el.setAttribute('data-sound', localStorage.getItem('sound') === 'on' ? 'on' : 'off');
          } catch (e) {
            el.setAttribute('data-sound', 'off');
          }
          if (window.matchMedia && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            el.classList.add('reveal-on');
          }
        }
        applyHtmlState();
        document.addEventListener('astro:after-swap', applyHtmlState);
      })();
    </script>
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <title>{docTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={docTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class={variant === 'home' ? 'is-home' : undefined}>
    {/* Background music lives in the layout (not the cube) and persists across view-transition
        swaps so it keeps playing as you navigate. src is set lazily, only once sound is on. */}
    <audio id="bg-music" loop preload="none" transition:persist="bg-music"></audio>
    <header class="site-header" transition:persist="site-header">
      <div class="container">
        <a class="site-title" href={href('')}>{SITE_TITLE}</a>
        <nav class="site-nav">
          <a href={href('')}>Home</a>
          <a href={href('blog')}>Blog</a>
          <a href={href('cv')}>CV</a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch theme">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </button>
          <!-- Opt-in sound: when on, the home-hero cube clacks on each turn over a lofi loop.
               Mirrors the theme toggle (data-sound on <html> + 'sound' in localStorage). -->
          <button id="sound-toggle" class="theme-toggle sound-toggle" type="button" aria-label="Turn sound on" aria-pressed="false">
            <svg class="icon-sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
            <svg class="icon-sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {year} {SITE_TITLE} · Built with <a href="https://astro.build">Astro</a>.</span>
        <ul class="footer-socials">
          {SOCIALS.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
        </ul>
      </div>
    </footer>

    <script>
      import { href } from '../lib/url';

      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // Sound toggle: flip data-sound, persist, and broadcast so the cube can react
      // (and so the toggle click itself is the user gesture that unlocks audio).
      const sbtn = document.getElementById('sound-toggle');
      if (sbtn) {
        const syncSound = (on) => {
          sbtn.setAttribute('aria-pressed', String(on));
          sbtn.setAttribute('aria-label', on ? 'Turn sound off' : 'Turn sound on');
        };
        syncSound(document.documentElement.getAttribute('data-sound') === 'on');
        sbtn.addEventListener('click', () => {
          const on = document.documentElement.getAttribute('data-sound') !== 'on';
          document.documentElement.setAttribute('data-sound', on ? 'on' : 'off');
          syncSound(on);
          try { localStorage.setItem('sound', on ? 'on' : 'off'); } catch (e) {}
          document.dispatchEvent(new CustomEvent('sound:changed', { detail: { on } }));
        });
      }

      // Background music: owns the persisted <audio id="bg-music">. Lazy (src set only when
      // sound is first enabled), low volume, and — because the element is transition:persist
      // and these listeners live on `document` — it keeps playing across page navigations.
      const music = document.getElementById('bg-music') as HTMLAudioElement | null;
      if (music) {
        const soundOn = () => document.documentElement.getAttribute('data-sound') === 'on';
        let loaded = false;
        const play = () => {
          if (!soundOn() || document.hidden) return;
          if (!loaded) {
            loaded = true;
            music.src = href('sounds/lofi-loop.mp3');
            music.volume = 0.22;
          }
          music.play().catch(() => {});
        };
        document.addEventListener('sound:changed', (e) => {
          if ((e as CustomEvent).detail?.on) play();
          else music.pause();
        });
        // Returning visitor already opted in — autoplay needs a gesture, so start on the first.
        if (soundOn()) document.addEventListener('pointerdown', play, { once: true });
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) music.pause();
          else if (soundOn()) play();
        });
      }
    </script>
  </body>
</html>
