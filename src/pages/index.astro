---
import BaseLayout from '../layouts/BaseLayout.astro';
import RubiksCube from '../components/RubiksCube.astro';
import { href } from '../lib/url';

// The intro copy lives in the inline script below — the lead line is the only one
// the cube narrates (keys map to it).
const CV_URL = href('cv');
const BLOG_URL = href('blog');
---

<BaseLayout title="Fábio Carneiro" variant="home">

  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Personal blog</p>
      <!-- Explicit break so the name wraps the same with the fallback serif and
           Source Serif — otherwise "Carneiro" jumps to line 2 when the web font
           swaps in. This matches how it already renders on desktop. -->
      <h1>Hi, I'm Fábio<br />Carneiro 👋</h1>
      <!-- The full intro is the no-JS / screen-reader / reduced-motion fallback.
           With the cube active, the inline script below collapses it to the first
           narrated line BEFORE paint (no flash), then steps through it on click. -->
      <p class="hero-lead">
        I'm allergic to black boxes — so I take them apart to see how they work. I
        write deep-dives into the tech I'm learning, chase outdoor adventures, and
        build in the open on GitHub.
      </p>
      <!-- Steps the cube/intro forward. Hidden until the cube is actually on
           screen (revealed by the script); stays hidden with no JS. -->
      <button class="cube-advance" type="button" hidden aria-label="Take the box apart">
        <span class="cube-advance__label">Take it apart</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </button>
      <!-- The payoff: hidden while the cube is being solved, popped in once it
           lands on a solved cube. CSS gates these on .reveal-on + viewport; the
           inline script below flips .hero.links-ready when the solve ends. With
           no JS / reduced motion / mobile, they simply show as normal. -->
      <div class="links-reveal">
        <p class="links-cue">Want to see more?</p>
        <div class="links">
          <a class="button" href={BLOG_URL}>Read the blog</a>
          <a class="button" href={CV_URL}>My CV</a>
        </div>
      </div>
    </div>
    <RubiksCube />
  </section>

  {/* Narrates the cube's solve into the intro copy. Runs synchronously pre-paint (so the
      lead is already collapsed to the first line — no flash) and, because this page can be
      navigated back to under View Transitions, re-runs pre-paint on every astro:after-swap.
      Kept is:inline (not a bundled module) precisely so it isn't deferred. */}
  <script is:inline>
    (function () {
      // The cube and the intro talk over events:
      //   cube -> page : `cube:narrate` {key}  — which line to show
      //                  `cube:busy`    {busy} — lock the button mid-animation
      //   page -> cube : `cube:advance`        — step forward (button click)
      // Copy lives here so it's edited in one obvious place. The narrator only
      // engages while the cube is visible and motion is allowed; otherwise the
      // full static intro above stays put (also what no-JS / SR always get).
      var COPY = {
        closed: "I'm allergic to black boxes.",
        open: 'So I take them apart to see how they work.',
        cross: 'First I find the structure hiding in the mess.',
        f2l: "Then I dig in — deep-dives into the tech I'm learning.",
        oll: 'I come up for air chasing outdoor adventures.',
        pll: 'Then I build it back in the open — all on GitHub.',
      };
      var label = function (key) { return key === 'closed' ? 'Take it apart' : 'Next'; };
      var reduce = matchMedia('(prefers-reduced-motion: reduce)');

      // Current-page refs + state, refreshed by setup() on each home visit.
      var lead, btn, hero, full, narrating, active;

      function cubeVisible() {
        var scene = document.querySelector('.rk-scene');
        return !!scene && getComputedStyle(scene).display !== 'none';
      }

      function showLine(key, animate) {
        var text = COPY[key];
        if (!text) return;
        if (hero) hero.classList.toggle('links-ready', key === 'pll'); // reveal links once solved
        if (btn) {
          btn.hidden = false;
          btn.setAttribute('aria-label', key === 'closed' ? 'Take the box apart' : 'Next');
          btn.classList.toggle('is-inviting', key === 'closed');
          var l = btn.querySelector('.cube-advance__label');
          if (l) l.textContent = label(key);
        }
        if (!narrating) {
          narrating = true;
          lead.classList.add('is-narrating');
          lead.textContent = text; // first line takes over the full intro
          return;
        }
        if (text === lead.textContent) return;
        if (!animate) { lead.textContent = text; return; }
        lead.classList.add('is-fading');
        window.setTimeout(function () {
          lead.textContent = text;
          lead.classList.remove('is-fading');
        }, 220);
      }

      function restoreFull() {
        if (!narrating) return;
        narrating = false;
        lead.classList.remove('is-narrating');
        lead.textContent = full;
        if (btn) btn.hidden = true;
        if (hero) hero.classList.remove('links-ready'); // back to the resting state
      }

      function onAdvance() {
        document.dispatchEvent(new CustomEvent('cube:advance'));
      }

      // Re-grab the (swapped-in) elements and reset state for the current home visit. The
      // button is a fresh element each visit, so its old listener is GC'd with the old one.
      function setup() {
        lead = document.querySelector('.hero-lead');
        btn = document.querySelector('.cube-advance');
        hero = document.querySelector('.hero');
        active = !!lead && !reduce.matches;
        if (!active) return;
        full = lead.textContent || '';
        narrating = false;
        if (btn) btn.addEventListener('click', onAdvance);
        if (cubeVisible()) showLine('closed', false); // collapse to the first line pre-paint
      }

      // Document listeners persist across swaps, so register them once and act on whatever
      // setup() last wired up (`active` is false off the home page / under reduced motion).
      document.addEventListener('cube:busy', function (e) {
        if (active && btn) btn.disabled = e.detail.busy;
      });
      document.addEventListener('cube:narrate', function (e) {
        if (!active) return;
        if (!cubeVisible()) return restoreFull();
        showLine(e.detail.key, true);
      });

      setup(); // initial load
      document.addEventListener('astro:after-swap', setup); // re-init pre-paint on each nav
    })();
  </script>
</BaseLayout>
