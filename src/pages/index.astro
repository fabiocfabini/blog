---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/url';

// TODO: replace the lorem intro with your real one; point CV at the real URL.
const CV_URL = '#';
const SOCIALS = [
  { label: 'GitHub', url: 'https://github.com/fabiocfabini' },
];
---

<BaseLayout title="Home" variant="home">
  <section class="hero">
    <p class="eyebrow">Personal blog</p>
    <h1>Hi, I'm Fábio Carneiro 👋</h1>
    <p class="hero-lead">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
      tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.
      <em>(Placeholder — your real intro goes here.)</em>
    </p>
    <div class="links">
      <a class="button primary" href={href('blog')}>Read the blog →</a>
      <a class="button" href={CV_URL}>My CV</a>
      {SOCIALS.map((s) => <a class="button" href={s.url}>{s.label}</a>)}
    </div>
  </section>
</BaseLayout>
